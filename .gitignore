# ─────────────────────────────────────────────────────────────────
# ClassLens AI — .gitignore
# ─────────────────────────────────────────────────────────────────

# Secrets
.env
.env.example
*.key
*.pem

# Virtual environments
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
*.xml

# Temporary media — NEVER commit recordings or extracted audio
tmp/
temp/
*.mp4
*.mp3
*.wav
*.webm
*.mov
*.avi
*.mkv
*.m4a
*.flac
*.ogg
*.aac

# Extracted frames
frames/
*.jpg
*.jpeg
*.png
*.bmp

# Generated reports (may contain transcript excerpts — keep local)
reports/
*.json

# Jupyter notebooks
*.ipynb
.ipynb_checkpoints/

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# Datasets / sample recordings — KEEP CONFIDENTIAL
data/
datasets/
recordings/
samples/

# Logs (may contain transcript text)
*.log
logs/
