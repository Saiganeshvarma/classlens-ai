# ─────────────────────────────────────────────────────────────────
# ClassLens AI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────

# ── AI Provider ──────────────────────────────────────────────────
# Choose: "gemini" | "openai" | "anthropic"
AI_PROVIDER=gemini

# Google Gemini (recommended - free tier available)
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI (required if AI_PROVIDER=openai)
# OPENAI_API_KEY=your-openai-api-key-here

# Anthropic (required if AI_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...

# ── Model selection ───────────────────────────────────────────────
# Transcription model (automatic - local Whisper for Gemini, API for others)
TRANSCRIPTION_MODEL=whisper-1

# Evaluation model — must support long context + (optionally) vision
# Gemini: gemini-1.5-flash | gemini-1.5-pro
# OpenAI: gpt-4o | gpt-4o-mini | gpt-4-turbo
# Anthropic: claude-3-5-sonnet-20241022 | claude-3-haiku-20240307
EVALUATION_MODEL=gemini-1.5-flash

# ── Processing limits ─────────────────────────────────────────────
# Maximum upload size in MB
MAX_FILE_SIZE_MB=500

# Maximum recording duration in seconds (default 3600 = 1 hour)
MAX_DURATION_SECONDS=3600

# Maximum number of video frames to extract for visual analysis
MAX_FRAMES=12

# Frame extraction interval in seconds (one frame per N seconds)
FRAME_INTERVAL_SECONDS=30

# ── Security ──────────────────────────────────────────────────────
# Comma-separated allowlist of trusted URL hosts for recording URLs.
# Leave blank to disable URL input entirely.
ALLOWED_URL_HOSTS=

# ── Scoring thresholds (0–100) ────────────────────────────────────
THRESHOLD_POOR_MAX=39
THRESHOLD_AVERAGE_MAX=59
THRESHOLD_GOOD_MAX=79
# Scores above THRESHOLD_GOOD_MAX are Excellent

# ── Logging ───────────────────────────────────────────────────────
# "DEBUG" | "INFO" | "WARNING" | "ERROR"
LOG_LEVEL=INFO

# ── Timeout Settings ──────────────────────────────────────────────
# Timeout for LLM API calls in seconds
LLM_TIMEOUT_SECONDS=600
